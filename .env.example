# Vivido Server Configuration
PORT=8787

# -------------------------------------------------------------
# AI Analysis Provider Configuration (Optional)
# If left empty, Vivido uses its built-in semantic engine (zero-config, free).
#
# Option A: Groq (Recommended - High-Speed LPU Inference, Free Tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Option B: OpenAI or OpenAI-compatible (OpenRouter, Ollama)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option C: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# Option D: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Option E: Custom Analysis Model Endpoint
# ANALYSIS_MODEL_URL=https://your-api.com/v1/analyze
# ANALYSIS_MODEL_AUTH=your-token

# -------------------------------------------------------------
# Image Generation Provider Configuration (Optional)
# If left empty, Vivido generates real 16:9 AI artwork via Pollinations FLUX (free, fast, zero-config).
#
# To use OpenAI DALL-E:
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=dall-e-3

# Or Custom Image Provider Endpoint (e.g. custom FLUX / SDXL / image proxy):
# IMAGE_MODEL_URL=https://your-api.com/v1/generate-image
# IMAGE_MODEL_AUTH=your-token
