{
  "manifest_version": 3,
  "name": "Vivido — AI Visual PDF Companion",
  "version": "1.0.0",
  "description": "Context-aware AI reading environment that turns books and PDFs into visual memory anchors.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Vivido AI Reader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
